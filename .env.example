# Spotifyn sovellustunnukset katalogin hakua varten.
# Hae osoitteesta https://developer.spotify.com/dashboard
#   Log in -> Create app -> Settings -> Client ID / Client secret
# Kopioi tämä tiedosto nimelle .env ja täytä arvot. .env ei mene versionhallintaan.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
