{
  "name": "korvamato",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "songs": "node scripts/build-library.mjs",
    "test": "npm run test:logic && npm run test:render",
    "test:logic": "esbuild scripts/selftest.ts --bundle --platform=node --format=esm --outfile=node_modules/.tmp/selftest.mjs --log-level=warning && node node_modules/.tmp/selftest.mjs",
    "test:render": "esbuild scripts/rendertest.tsx --bundle --packages=external --platform=node --format=esm --jsx=automatic --outfile=node_modules/.tmp/rendertest.mjs --log-level=warning && node node_modules/.tmp/rendertest.mjs"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
